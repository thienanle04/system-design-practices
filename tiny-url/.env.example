# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tinyurl
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tinyurl

# Redis Configuration
REDIS_HOST=redis
