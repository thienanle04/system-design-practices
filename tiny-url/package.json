{
  "name": "tiny-url",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/url-service",
    "dev:kgs": "npm run dev --workspace=apps/kgs-service",
    "dev:analytics": "npm run dev --workspace=apps/analytics-service",
    "dev:web": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7"
  }
}
